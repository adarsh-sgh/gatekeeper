        },
        "tenant": {
          "type": "string"
        },
        "caller": {
          "type": "string"
        },
        "subject": {
          "$ref": "#/definitions/v1Subject"
        },
        "action": {
          "type": "string"
        },
        "resource": {
          "$ref": "#/definitions/v1Resource"
        },
