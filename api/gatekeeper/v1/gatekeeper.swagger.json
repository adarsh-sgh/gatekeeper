        "shadow": {
          "type": "boolean",
          "description": "shadow=true installs the version alongside the active one: it is evaluated\non every Check and divergence is logged, but the old decision is served."
        },
        "tenant": {
          "type": "string",
          "description": "Empty means the caller's tenant."
        }
      }
    },
    "v1PutPolicyResponse": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
